<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Version>1.0.0</Version>
    <Product>Watchboard</Product>
    <Description>Local software release monitoring and game price tracking API.</Description>
    <Authors>David-H-Afonso</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/David-H-Afonso/Watchboard.Api</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Watchboard.Api.Tests/**/*.cs" />
    <Content Remove="Watchboard.Api.Tests/**/*" />
    <None Remove="Watchboard.Api.Tests/**/*" />
    <EmbeddedResource Remove="Watchboard.Api.Tests/**/*" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="AngleSharp" Version="1.10.1" />
  </ItemGroup>
</Project>
