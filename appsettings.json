{
  "Urls": "http://127.0.0.1:5197",
  "AllowedHosts": "localhost;127.0.0.1;[::1]",
  "Watchboard": {
    "DatabasePath": "storage/watchboard.db",
    "EnablePolling": true,
    "SeedDefaults": true,
    "PriceIntervalMinutes": 1440,
    "VersionIntervalMinutes": 360
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  }
}
